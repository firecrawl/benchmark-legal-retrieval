# Secrets. .env.example is the template and is tracked; .env never is.
.env
.env.*
!.env.example

# Held-out ground truth. Only the public rows ship; a full set copied in locally stays out.
dataset/*.jsonl
!dataset/legal-retrieval-public.jsonl

# Local run output: a fire-evals results database or export made in this checkout.
results.db
exports/

__pycache__/
*.py[cod]
.venv/
venv/
env/
